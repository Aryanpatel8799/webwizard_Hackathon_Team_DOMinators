PORT=4000
MONGO_URI=mongodb://mongo:27017/eventreg
JWT_SECRET=supersecret_change_in_production
JWT_EXPIRES_IN=7d

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Event Team <no-reply@example.com>"

# Alternative: SendGrid (comment out SMTP above if using SendGrid)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Redis Configuration
REDIS_URL=redis://redis:6379

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20

# Seat Hold Configuration (in seconds)
SEAT_HOLD_SECONDS=120

# Application URL
BASE_URL=http://localhost:4000

# Environment
NODE_ENV=development

# Optional: reCAPTCHA (uncomment to enable)
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# File Upload Limits
MAX_FILE_SIZE=5242880

# Database Options
DB_OPTIONS_MAX_POOL_SIZE=10
DB_OPTIONS_SERVER_SELECTION_TIMEOUT=5000
